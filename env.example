# Server-only secrets / configuration. NEVER commit your real .env file.
# Firebase web config is browser-visible by design, but keeping it here prevents
# raw API keys from being embedded in the repository and allows provider restrictions.

FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=civicsync-69010.firebaseapp.com
FIREBASE_PROJECT_ID=civicsync-69010
FIREBASE_STORAGE_BUCKET=civicsync-69010.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=328301187829
FIREBASE_APP_ID=REPLACE_WITH_YOUR_FIREBASE_APP_ID

# Real Gemini key: keep this server-side only.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# The officer password is managed in Firebase Authentication; it is NOT stored here.
